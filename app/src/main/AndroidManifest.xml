<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solo para "Validar en WA": busca en la agenda el número escrito a mano (no se lista la agenda). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- SMS de los envíos: se pide la primera vez que se usa (si Android lo bloquea por estar instalada a mano:
         Info de la app > Permitir ajustes restringidos). El resultado de cada SMS lo recibe el núcleo. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Para saber si está WhatsApp (o WhatsApp Business) y abrirlo con el texto precargado. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <!-- Permisos y receivers de alarmas: vienen del manifiesto de :nucleo. -->
    <application
        android:name=".AppMensajes"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Tema">

        <!-- "Enviar SMS" en la notificación (con el permiso ya dado). -->
        <receiver android:name=".SmsAccionReceiver" android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EditarActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ContactosActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".PlantillasActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AjustesActivity"
            android:exported="false" />

        <activity
            android:name=".EnviarActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".PosponerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/TemaTransparente" />

        <activity
            android:name=".AlarmaActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity="com.mismensajes.alarma"
            android:turnScreenOn="true" />

    </application>
</manifest>
