<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/enTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/enDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/texto2"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/enProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/acento"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/enLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/enSiguiente"
            style="@style/Boton.Principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="17sp" />

        <Button
            android:id="@+id/enCerrar"
            style="@style/Boton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cerrar envío (Hecho)" />

        <TextView
            android:id="@+id/enAyuda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tocá un contacto para enviarle solo a él. Mantenelo presionado para marcarlo o desmarcarlo como enviado."
            android:textColor="@color/texto3"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
