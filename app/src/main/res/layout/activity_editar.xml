<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/estadoEnvio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@color/aviso_fondo"
            android:padding="12dp"
            android:textColor="@color/aviso_texto"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            style="@style/EtiquetaCampo"
            android:text="Título (opcional)" />

        <EditText
            android:id="@+id/edTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Para reconocerlo en la lista"
            android:inputType="textCapSentences" />

        <TextView
            style="@style/EtiquetaCampo"
            android:text="Contactos" />

        <TextView
            android:id="@+id/txtContactos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnContactos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Elegir contactos" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUsarLista"
                style="@style/Boton.Chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Usar lista" />

            <Button
                android:id="@+id/btnGuardarLista"
                style="@style/Boton.Chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Guardar como lista" />
        </LinearLayout>

        <TextView
            style="@style/EtiquetaCampo"
            android:text="Texto" />

        <RadioGroup
            android:id="@+id/rgModo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbMismo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mismo texto para todos"
                android:textColor="@color/texto" />

            <RadioButton
                android:id="@+id/rbPorContacto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Un texto por contacto"
                android:textColor="@color/texto" />
        </RadioGroup>

        <EditText
            android:id="@+id/edTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="Mensaje a enviar"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3" />

        <LinearLayout
            android:id="@+id/cajaTextos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnVariable"
            style="@style/Boton.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="+ Insertar variable ({nombre}, {saludo}…)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUsarPlantilla"
                style="@style/Boton.Chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Usar plantilla" />

            <Button
                android:id="@+id/btnGuardarPlantilla"
                style="@style/Boton.Chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Guardar como plantilla" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtVista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/texto2"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Largo del SMS (solo si algún destinatario va por SMS); al tocarlo, el detalle. -->
        <TextView
            android:id="@+id/txtSms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/texto2"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            style="@style/EtiquetaCampo"
            android:text="Fecha y hora" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFecha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2" />

            <Button
                android:id="@+id/btnHora"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            style="@style/EtiquetaCampo"
            android:text="Repetición" />

        <Spinner
            android:id="@+id/spRepeticion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <LinearLayout
            android:id="@+id/filaDias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/filaExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/txtRepeticion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/texto2"
            android:textSize="13sp"
            android:visibility="gone" />

        <Switch
            android:id="@+id/swAlarma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="Sonar como alarma (pantalla completa)"
            android:textColor="@color/texto"
            android:textSize="15sp" />

        <!-- Apertura automática de WhatsApp en este envío (según Ajustes / sí / no). -->
        <Button
            android:id="@+id/btnAutoAbrir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnGuardar"
            style="@style/Boton.Principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Guardar y programar" />

        <Button
            android:id="@+id/btnBorrar"
            style="@style/Boton.Peligro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Borrar envío"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
